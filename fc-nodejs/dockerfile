# fc-nodejs: Node.js and npm from Ubuntu's packages
ARG OS_VERSION=ubuntu26.04
FROM fc-os:${OS_VERSION}

# Label only: Ubuntu ships one Node.js version (22.22 on 26.04); the tag records which
ARG NODEJS_VERSION=22.22

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

CMD ["tail", "-f", "/dev/null"]
